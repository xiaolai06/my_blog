---
import ImageScene from './ImageScene.astro';
import WindPetals from './WindPetals.astro';
import '../styles/footer-time.css';
interface Props { variant?: 'default' | 'projects' | 'journal' | 'about' }
const { variant = 'default' } = Astro.props;
const projectScene = variant === 'projects';
const journalScene = variant === 'journal';
const aboutScene = variant === 'about';
const family = aboutScene ? 'about' : journalScene ? 'journal' : projectScene ? 'projects' : 'home';
---
<footer class:list={['scenic-footer',{'project-scenic-footer':projectScene || journalScene || aboutScene,'journal-scenic-footer':journalScene,'about-scenic-footer':aboutScene}]}>
 <div class="footer-landscape" data-footer-scene data-scene-region="footer" data-scene-family={family} data-phase="dusk">
  <ImageScene family={family} kind="footer" imageClass="footer-scenery"/>
  <div class="footer-atmosphere" aria-hidden="true">
   {projectScene && <svg class="stream-reflections" viewBox="0 0 2172 724" preserveAspectRatio="xMaxYMax slice" fill="none">
    <g class="stream-current stream-current-near"><path d="M1300 708 Q1348 704 1390 708 M1435 691 Q1480 686 1515 691 M1532 720 Q1585 715 1630 720 M1720 692 Q1750 688 1785 692 M1810 666 Q1853 662 1882 666"/><path d="M1435 667 Q1476 663 1514 667 M1560 643 Q1591 640 1620 643 M1660 620 Q1695 617 1723 620 M1785 644 Q1810 641 1843 644"/></g>
    <g class="stream-current stream-current-far"><path d="M1645 583 Q1670 580 1694 583 M1720 603 Q1740 600 1768 603 M1665 654 Q1690 651 1722 654 M1530 680 Q1570 677 1605 680"/></g>
    <ellipse class="stream-ripple" cx="1700" cy="663" rx="24" ry="3"/>
    <ellipse class="stream-ripple stream-ripple-late" cx="1510" cy="702" rx="32" ry="4"/>
   </svg>}
   <span class="footer-haze"></span><span class="footer-mist footer-mist-near"></span><span class="footer-mist footer-mist-far"></span>
   <WindPetals zone="footer"/>
   <span class="footer-lights">
   {Array.from({length:14},(_,i)=><i class="footer-firefly" style={`--light-left:${7+i*6.7}%;--light-bottom:${12+i%5*9}%;--light-delay:-${i*1.3}s;--light-duration:${7+i%4*1.9}s`}/>)}
   </span>
  </div>
  <p class="sr-only" data-scene-status aria-live="polite" aria-atomic="true">随本机时间，山色流转</p>
 </div>
</footer>
<script>
 import { setupFooterTime } from '../scripts/footer-time';
 setupFooterTime();
</script>
