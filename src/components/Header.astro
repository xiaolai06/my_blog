---
import Icon from './Icon.astro';
import Flower from './Flower.astro';
import { SITE_TITLE, SITE_TITLE_EN } from '../consts';
const { overlay = false } = Astro.props;
const links = [['/', '首页'], ['/projects/', '项目'], ['/blog/', '手记'], ['/about/', '关于']];
const path = Astro.url.pathname;
---
<header class:list={['site-header', { 'header-overlay': overlay }]} transition:name="site-header" transition:animate="none">
<div class="header-inner container">
<a class="brand" href="/" aria-label={`${SITE_TITLE}首页`}><span class="brand-emblem" aria-hidden="true"><Flower size={34} colored/></span><span class="brand-wordmark"><span class="brand-name">{SITE_TITLE}</span><small lang="en">{SITE_TITLE_EN}</small></span></a>
<nav class="desktop-nav" aria-label="主导航">{links.map(([url,label]) => {
const active = url === '/' ? path === '/' : path.startsWith(url);
return <a href={url} aria-current={active ? 'page' : undefined}>{label}{active&&<span class="nav-indicator" aria-hidden="true" transition:name="nav-indicator"/>}</a>;
})}</nav>
<div class="header-actions">
<button class="icon-button search-trigger" aria-label="搜索项目与手记" title="搜索（Ctrl / ⌘ K）"><Icon name="search"/></button>
<button class="icon-button theme-toggle" aria-label="切换深色主题" title="切换阅读主题"><span class="theme-moon"><Icon name="moon"/></span><span class="theme-sun"><Icon name="sun"/></span></button>
<button class="icon-button menu-toggle" aria-label="打开导航菜单" aria-expanded="false" aria-controls="mobile-navigation"><Icon name="menu"/></button>
</div></div>
<nav id="mobile-navigation" class="mobile-nav" aria-label="手机导航" hidden>{links.map(([url,label]) => <a href={url} aria-current={(url === '/' ? path === '/' : path.startsWith(url)) ? 'page' : undefined}>{label}<Icon name="arrow" size={16}/></a>)}</nav>
</header>
