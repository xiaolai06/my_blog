---
import Icon from './Icon.astro';
import JournalDatePicker from './JournalDatePicker.astro';
interface Props {dates:string[]}
const {dates}=Astro.props;
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const [year,month]=today.split('-').map(Number);
const offset=(new Date(year,month-1,1).getDay()+6)%7;
const cellCount=Math.ceil((offset+new Date(year,month,0).getDate())/7)*7;
const cells=Array.from({length:cellCount},(_,index)=>{
 const day=new Date(year,month-1,index-offset+1),key=`${day.getFullYear()}-${String(day.getMonth()+1).padStart(2,'0')}-${String(day.getDate()).padStart(2,'0')}`;
 return {key,day:day.getDate(),outside:day.getMonth()!==month-1,count:dates.filter(date=>date===key).length};
});
---
<section class="archive-date-panel" aria-labelledby="diary-calendar-label">
 <div class="diary-panel-heading"><h2 id="diary-calendar-label"><Icon name="calendar" size={18}/>翻阅日历</h2><button type="button" data-range-open aria-haspopup="dialog" aria-controls="diary-date-dialog">自定义日期<Icon name="arrow-up-right" size={14}/></button></div>
 <div class="archive-date-content">
  <div class="archive-date-shortcuts" role="group" aria-label="快捷日期">{[{id:'today',label:'今天'},{id:'week',label:'本周'},{id:'month',label:'本月'},{id:'latest',label:'最近记录'}].map(item=><button type="button" data-date-shortcut={item.id} aria-pressed="false">{item.label}</button>)}</div>
  <div class="diary-calendar" data-diary-calendar>
   <div class="diary-calendar-heading"><button type="button" data-calendar-prev aria-label="上个月"><Icon name="chevron" size={18} class="rotate"/></button><button type="button" data-calendar-picker aria-expanded="false"><span data-calendar-title>{year} 年 {month} 月</span><Icon name="down-chevron" size={14}/></button><button type="button" data-calendar-next aria-label="下个月"><Icon name="chevron" size={18}/></button></div>
   <div class="diary-month-picker" hidden><div><button type="button" data-calendar-year-prev aria-label="上一年"><Icon name="chevron" size={16} class="rotate"/></button><strong data-calendar-year>{year} 年</strong><button type="button" data-calendar-year-next aria-label="下一年"><Icon name="chevron" size={16}/></button></div><div class="diary-months" role="group" aria-label="选择月份"></div></div>
   <div data-calendar-grid><div class="diary-weekdays" aria-hidden="true">{['一','二','三','四','五','六','日'].map(day=><span>{day}</span>)}</div><div class="diary-days" role="group" aria-label="按日期检索记录，方向键移动，回车选择">{cells.map(cell=><button type="button" data-diary-date={cell.key} class:list={{'other-month':cell.outside,'has-entry':cell.count>0}} tabindex={cell.key===today?0:-1} aria-current={cell.key===today?'date':undefined} aria-pressed="false" aria-label={`${cell.key}，${cell.count} 篇记录`}><span>{cell.day}</span><small>{cell.count?`${cell.count}篇`:'0'}</small></button>)}</div></div>
   <div class="diary-calendar-footer"><span>每日记录<span data-calendar-month-count>{dates.filter(date=>date.startsWith(today.slice(0,7))).length} 篇 / 本月</span></span><button type="button" data-calendar-month-filter>查看整月<Icon name="arrow" size={14}/></button></div>
  </div>
  <div class="diary-date-state" hidden><p data-calendar-note></p><button type="button" data-clear-date>清除日期<Icon name="close" size={13}/></button></div>
 </div>
</section>
<JournalDatePicker/>
