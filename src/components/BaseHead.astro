---
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/header.css';
import '../styles/scene-glass.css';
import '../styles/atmosphere.css';
import '../styles/scene-framing.css';
import '../styles/scene-blending.css';
import '../styles/interaction-motion.css';
import '../styles/page-transitions.css';
import '../styles/mobile-layout.css';
import { SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
interface Props { title: string; description: string; image?: string }
const { title, description, image = '/images/sakura-sunset.webp' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---
<meta charset="utf-8"/>
<ClientRouter fallback="animate"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<link rel="preload" href="/fonts/noto-serif-sc.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/fonts/noto-sans-sc.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml"/>
<link rel="canonical" href={canonicalURL}/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="zh_CN"/>
<meta property="og:url" content={canonicalURL}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:image" content={new URL(image, Astro.url)}/>
<meta name="twitter:card" content="summary_large_image"/>
<script is:inline data-astro-rerun>
(()=>{
const sceneHour=new Date().getHours();
document.documentElement.dataset.scenetime=sceneHour>=5&&sceneHour<9?'dawn':sceneHour>=9&&sceneHour<16?'day':sceneHour>=16&&sceneHour<19?'dusk':'night';
let theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';
let motion='on';
try {
const savedTheme=localStorage.getItem('sakura-theme');
if(savedTheme==='dark'||savedTheme==='light')theme=savedTheme;
motion=localStorage.getItem('sakura-motion')==='off'?'off':'on';
} catch {}
document.documentElement.dataset.theme=theme;
document.documentElement.dataset.motion=motion;
})();
</script>
<script>import '../scripts/page-lifecycle';</script>
