---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Flower from '../components/Flower.astro';
import { profile, skills, education, honors, experiences, strengths, interests } from '../data/profile';
import '../styles/about.css';
const emailHref = `mailto:${profile.email}`;
---
<SiteLayout aboutPage title="关于我" image="/images/scenes-v2/about-hero-dusk-desktop-2172.webp" description="赖沛盛的个人简介与求职作品集：深圳职业技术大学计算机应用技术在校生，分享软件开发、数据与智能技术实践，以及学习、责任心和团队协作中的成长。">
 <link slot="head" rel="preload" href="/fonts/ma-shan-zheng-about.woff2" as="font" type="font/woff2" crossorigin/>
 <main id="main-content" class="container inner-main about-content">
  <h1 class="about-print-title">{profile.name} · 开发者简历</h1>
  <div class="about-wayfinding">
   <nav class="breadcrumb" aria-label="当前位置"><a href="/">首页</a><Icon name="chevron" size={14}/><span aria-current="page">关于我</span></nav>
   <nav class="about-jump-links" aria-label="关于页章节"><a href="#hello">个人简介</a><a href="#skills">专业技能</a><a href="#background">教育荣誉</a><a href="#experience">实践经历</a><a href="#assessment">自我评价</a><a href="#interests">兴趣爱好</a></nav>
   <button class="about-print-button" type="button" data-resume-print><Icon name="printer" size={17}/>打印 / 保存简历</button>
  </div>

  <section id="hello" class="about-introduction" aria-labelledby="hello-title">
   <div class="about-resume-intro">
    <p class="about-eyebrow"><span></span> PERSONAL PROFILE / 个人简介</p>
    <h2 id="hello-title">你好，我是 <span>{profile.name}</span><span class="about-heading-dot">。</span></h2>
    <div class="about-career" aria-labelledby="career-label"><p id="career-label" class="about-career-label"><Icon name="code" size={16}/>求职意向</p><ul class="about-career-roles">{profile.jobInterests.map(job => <li><span>{job.title}</span>{job.method && <small lang="en">{job.method}</small>}</li>)}</ul></div>
    <p class="about-intro-lead">保持广泛的兴趣，把学习落到具体的实现。</p>
    <p>我就读于深圳职业技术大学计算机应用技术专业，在项目中接触并使用过多种编程语言、前后端框架、数据库和 AI 开发工具，也尝试过数据处理与机器人相关实践。希望通过不同类型的任务，逐步建立对完整开发过程的理解。</p>
    <p>我倾向于全面发展的开发路线，愿意参与需求梳理、界面与功能实现、联调测试和部署维护。对新技术先了解原理与适用场景，再按实际需要深入，在动手解决问题的过程中拓宽能力范围。</p>
    <div class="about-intro-note"><span><Icon name="check" size={20}/></span><p><strong>我的做事方式</strong>先理解需求，再动手验证；主动同步进展，认真对待反馈，把负责的事情跟进到有结果。</p></div>
    <dl class="about-resume-facts">
     <div><dt>发展目标</dt><dd>综合型开发者</dd></div>
     <div><dt>所在地</dt><dd>{profile.location}</dd></div>
     <div><dt>学习方式</dt><dd>广泛了解 · 按需深入</dd></div>
     <div><dt>当前身份</dt><dd>计算机应用技术 · 在校生</dd></div>
    </dl>
    <div class="about-intro-actions"><a class="button about-project-button" href="/projects/">查看我的作品<Icon name="arrow-up-right" size={18}/></a><a class="about-text-link" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="访问 GitHub 主页（新窗口）"><Icon name="github" size={18}/>GitHub 主页<Icon name="arrow-up-right" size={15}/></a></div>
   </div>

   <aside id="contact" class="about-resume-card" aria-label={`${profile.name} 的个人资料与联系方式`}>
    <div class="about-card-scenery" aria-hidden="true"><img src="/images/scenes-v2/about-footer-dusk-desktop-1280.webp" alt="" width="1280" height="427" loading="lazy" decoding="async"/></div>
    <div class="about-card-cover"><span class="about-image-label"><Flower size={16} colored/>个人名片 <span> / PROFILE</span></span><span class="about-card-city"><Icon name="pin" size={14}/>{profile.location}</span></div>
    <div class="about-card-glass">
     <div class="about-card-identity"><div class="about-card-avatar" aria-hidden="true"><Flower size={43} colored/></div><div><p class="about-card-name">{profile.name}<span lang="en">{profile.handle}</span></p><p class="about-card-role"><span>{education.major}</span><span>在校生</span></p></div></div>
     <p class="about-card-school"><Icon name="graduation" size={18}/>{education.school}</p>
     <ul class="about-card-directions" aria-label="求职方向">{profile.jobInterests.map(job => <li>{job.label}</li>)}</ul>
     <dl class="about-resume-contacts">
      <div class="about-resume-contact about-contact-wide"><Icon name="mail" size={21}/><div><dt>电子邮箱</dt><dd><a href={emailHref}>{profile.email}</a></dd></div><button type="button" class="about-copy-button" data-copy-value={profile.email} data-copy-label="邮箱" aria-label="复制邮箱" title="复制邮箱"><span class="about-copy-default"><Icon name="copy" size={18}/></span><span class="about-copy-done"><Icon name="check" size={18}/></span></button></div>
      <div class="about-resume-contact about-contact-social"><Icon name="phone" size={21}/><div><dt>手机号码</dt><dd><a href={`tel:${profile.phone}`}>{profile.phone}</a></dd></div><button type="button" class="about-copy-button" data-copy-value={profile.phone} data-copy-label="手机号" aria-label="复制手机号" title="复制手机号"><span class="about-copy-default"><Icon name="copy" size={18}/></span><span class="about-copy-done"><Icon name="check" size={18}/></span></button></div>
      <div class="about-resume-contact about-contact-social"><Icon name="message" size={19}/><div><dt>微信</dt><dd>{profile.wechat}</dd></div><button type="button" class="about-copy-button" data-copy-value={profile.wechat} data-copy-label="微信号" aria-label="复制微信号" title="复制微信号"><span class="about-copy-default"><Icon name="copy" size={17}/></span><span class="about-copy-done"><Icon name="check" size={17}/></span></button></div>
      <div class="about-resume-contact about-contact-social"><Icon name="people" size={19}/><div><dt>QQ</dt><dd>{profile.qq}</dd></div><button type="button" class="about-copy-button" data-copy-value={profile.qq} data-copy-label="QQ号" aria-label="复制QQ号" title="复制QQ号"><span class="about-copy-default"><Icon name="copy" size={17}/></span><span class="about-copy-done"><Icon name="check" size={17}/></span></button></div>
      <div class="about-resume-contact about-contact-social"><Icon name="github" size={21}/><div><dt>GitHub</dt><dd><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={`访问 ${profile.name} 的 GitHub 主页（新窗口）`}>@{profile.handle}</a></dd></div><Icon name="arrow-up-right" size={18}/></div>
     </dl>
     <p class="about-copy-feedback" data-copy-status role="status" aria-live="polite">欢迎通过以上方式联系我。</p>
    </div>
   </aside>
  </section>

  <section id="skills" class="about-section" aria-labelledby="skills-title">
   <header class="about-section-heading"><div><p class="about-eyebrow">01 / PROFESSIONAL SKILLS</p><h2 id="skills-title">专业技能<span>以数据为基础，连接模型与应用。</span></h2></div><a class="about-text-link" href="/projects/">在作品中了解更多<Icon name="arrow-up-right" size={17}/></a></header>
   <div class="about-skills-grid">{skills.map(skill => <article class="about-skill"><header><span class="about-skill-icon"><Icon name={skill.icon} size={25}/></span><div><p class="about-skill-english" lang="en">{skill.english}</p><h3>{skill.title}</h3></div></header><p class="about-skill-description">{skill.description}</p><ul class="about-tool-tags" aria-label={`${skill.title}的工具与方向`}>{skill.tools.map(tool => <li>{tool}</li>)}</ul></article>)}</div>
  </section>

  <section id="background" class="about-section" aria-labelledby="background-title">
   <header class="about-section-heading"><div><p class="about-eyebrow">02 / EDUCATION & HONORS</p><h2 id="background-title">教育与荣誉<span>在学习和竞赛中积累。</span></h2></div></header>
   <div class="about-background-grid">
    <article class="about-education-card">
     <div class="about-education-heading"><span class="about-detail-icon"><Icon name="graduation" size={26}/></span><div><p class="about-small-label">EDUCATION / 教育背景</p><h3>{education.school}</h3></div></div>
     <div class="about-education-meta"><p>{education.major} <span>{education.degree}</span></p><span>{education.period}</span></div>
     <p class="about-education-description">{education.description}</p>
     <dl class="about-academic-metrics">{education.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}<span>{metric.suffix}</span></dd></div>)}</dl>
     <div class="about-courses"><h4>核心课程 <span>成绩 / 百分制</span></h4><ul>{education.courses.map(course => <li><span>{course.name}</span><strong>{course.score}</strong></li>)}</ul></div>
     <div class="about-education-note"><Icon name="layers" size={19}/><p><strong>把所学放进实践</strong>将编程、机器视觉与智能控制课程中的知识，用于机器人、模型训练和应用开发，逐步积累从数据处理到部署的经验。</p></div>
    </article>
    <article class="about-honors-card">
     <header><span class="about-detail-icon"><Icon name="trophy" size={25}/></span><div><p class="about-small-label">HONORS & AWARDS</p><h3>竞赛与荣誉</h3></div></header>
     <ul>{honors.map(honor => <li><div class="about-honor-meta"><span class="about-honor-year">{honor.year}</span><span>{honor.category}</span></div><div><h4>{honor.title}</h4><p>{honor.detail}</p></div></li>)}</ul>
    </article>
   </div>
  </section>

  <section id="experience" class="about-section about-experience" aria-labelledby="experience-title">
   <div class="about-experience-intro"><p class="about-eyebrow">03 / EXPERIENCE</p><h2 id="experience-title">校园与社会实践</h2><p class="about-experience-lead">从技术支持到课堂，<br/>把事情认真做好。</p><p>在真实任务中练习数据处理、问题排查和团队协作，也在教学中学习表达与倾听。</p><a class="about-text-link" href="/projects/">查看开发作品<Icon name="arrow" size={17}/></a></div>
   <ol class="about-experience-list">{experiences.map((item,index) => <li><span class="about-experience-marker">0{index + 1}</span><article><div class="about-experience-top"><div><p class="about-experience-kind">{item.kind}</p><h3>{item.title}</h3></div><span class="about-experience-period">{item.period}</span></div><p class="about-experience-organization">{item.organization}</p><p class="about-experience-summary">{item.summary}</p><ul>{item.points.map(point => <li><Icon name="check" size={15}/><span>{point}</span></li>)}</ul></article></li>)}</ol>
  </section>

  <section id="assessment" class="about-section" aria-labelledby="strengths-title">
   <header class="about-section-heading"><div><p class="about-eyebrow">04 / SELF-ASSESSMENT</p><h2 id="strengths-title">自我评价<span>在学习、做事与合作中持续成长。</span></h2></div></header>
   <p class="about-assessment-lead">我希望成长为知识面较广、能够参与完整开发过程的开发者。对多种技术保持好奇，愿意根据任务持续学习和深入实践；也重视责任心、执行力与团队合作，认真对待分工和反馈，在解决具体问题的过程中逐步积累能力。</p>
   <div class="about-strengths-grid">{strengths.map(item => <article class="about-strength-card"><span class="about-detail-icon"><Icon name={item.icon} size={23}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>

  <section id="interests" class="about-section about-interests" aria-labelledby="interests-title">
   <header class="about-section-heading"><div><p class="about-eyebrow">05 / LIFE & INTERESTS</p><h2 id="interests-title">兴趣与日常<span>工作之外，也保持好奇。</span></h2></div></header>
   <div class="about-interests-grid">{interests.map(item => <article class="about-interest"><span><Icon name={item.icon} size={23}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>
 </main>
</SiteLayout>
<script>
 const initializedResumePages = new WeakSet<HTMLElement>();
 function setupResumePage() {
 const root = document.querySelector<HTMLElement>('.about-content');
 if (!root || initializedResumePages.has(root)) return;
 initializedResumePages.add(root);
 const copyButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-copy-value]'));
 const copyStatus = root.querySelector<HTMLElement>('[data-copy-status]');
 let resetTimer: ReturnType<typeof setTimeout>;
 const resetCopies = () => copyButtons.forEach(button => {
  delete button.dataset.copied;
  button.setAttribute('aria-label', `复制${button.dataset.copyLabel}`);
 });
 copyButtons.forEach(copyButton => copyButton.addEventListener('click', async () => {
  const label = copyButton.dataset.copyLabel || '内容';
  copyButton.disabled = true;
  try {
   await navigator.clipboard.writeText(copyButton.dataset.copyValue || '');
   clearTimeout(resetTimer);
   resetCopies();
   copyButton.dataset.copied = 'true';
   copyButton.setAttribute('aria-label', `${label}已复制`);
   if (copyStatus) copyStatus.textContent = `${label}已复制，可以粘贴使用。`;
   resetTimer = setTimeout(() => {
    resetCopies();
    if (copyStatus) copyStatus.textContent = '欢迎通过以上方式联系我。';
   }, 4000);
  } catch {
   if (copyStatus) copyStatus.textContent = `${label}复制未完成，可以直接选择文字。`;
  } finally {
   copyButton.disabled = false;
  }
 }));
 document.addEventListener('astro:before-swap', () => clearTimeout(resetTimer), { once: true });
 root.querySelector('[data-resume-print]')?.addEventListener('click', () => window.print());
 }
 document.addEventListener('astro:page-load', setupResumePage);
 setupResumePage();
</script>
