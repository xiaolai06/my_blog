---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Sidebar from '../components/Sidebar.astro';
import JournalList from '../components/JournalList.astro';
import Icon from '../components/Icon.astro';
import Flower from '../components/Flower.astro';
import { projects } from '../data/projects';
import '../styles/home.css';
---
<SiteLayout hero>
<Hero/>
<main id="main-content" class="container home-main">
<div class="welcome-line"><p>一个记录创造与成长的小小空间。</p><span>Code <i>/</i> Create <i>/</i> Life <Flower size={18}/></span></div>
<section id="projects" class="projects-section" data-project-section>
<div class="section-heading"><div><h2>精选项目 <em>Selected works</em></h2><p class="section-intro">把日常里的问题，做成有温度的作品。</p></div><div class="project-filters" aria-label="项目分类">{['全部','校园生活','经营管理'].map((label,i)=><button class:list={['filter-button',{active:i===0}]} data-filter={label} aria-pressed={i===0}>{label}</button>)}</div></div>
<div class="home-columns">
<div class="main-column">
<div class="project-grid">{projects.map((p,i)=><ProjectCard project={p} index={i} showCategory/>)}</div>
</div>
<Sidebar/>
</div>
<div class="projects-section-footer"><a class="text-link all-projects" href="/projects/">走进作品集<Icon name="arrow" size={16}/></a></div>
<p class="filter-status sr-only" aria-live="polite"></p>
</section>
<section class="journal-section" id="journals"><div class="section-divider"><span></span><Flower size={24}/><span></span></div><div class="section-heading"><div><h2>最新手记 <em>Latest journals</em></h2><p class="section-intro">项目里的思考，和代码之外的片刻。</p></div><a class="text-link" href="/blog/">更多手记<Icon name="arrow" size={18}/></a></div><JournalList limit={3} illustrated/></section>
</main>
</SiteLayout>
